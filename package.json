{
  "name": "jzd",
  "version": "1.0.0",
  "description": "Jeden z Dziesięciu - gra quizowa w czasie rzeczywistym",
  "type": "module",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "start:prod": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit"
  },
  "keywords": [
    "jzd",
    "quiz",
    "jeden-z-dziesieciu",
    "game",
    "socketio"
  ],
  "author": "Michał Świątek",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.32",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/static": "^10.1.10",
    "canvas-confetti": "^1.9.4",
    "fastify": "^5.12.8",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4"
  }
}
